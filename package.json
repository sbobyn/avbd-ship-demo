{
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/three": "0.186.0",
    "@webgpu/types": "^0.1.74",
    "three": "0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "webgpu": "0.6.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "webgpu"
    ]
  },
  "name": "avbd-ship-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Windward \u2014 interactive WebGPU ocean, ship and AVBD cloth demo",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5319 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5319 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:gpu": "node --experimental-transform-types --test tests-gpu/*.gpu.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:gpu && pnpm build"
  }
}
